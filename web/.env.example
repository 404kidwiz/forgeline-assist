# All optional. Leave unset to run fully mocked / simulated.
# Dify Workflow adapter (server-only; never NEXT_PUBLIC_)
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai
# GitHub test repository for real issue creation after approval ("owner/repo")
GITHUB_TOKEN=
GITHUB_REPO=
# HMAC secret for /api/webhooks/github; unset → endpoint returns 503
GITHUB_WEBHOOK_SECRET=
